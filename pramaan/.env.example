# ─────────────────────────────────────────────────────────────────────────────
# ET Nucleus — SINGLE SHARED environment TEMPLATE (backend + frontend)
# Copy to `.env` (one file, at this directory — next to backend/ and frontend/).
# There are no other .env files.
#   • Backend reads it via backend/src/config/index.js
#   • Frontend (Vite) reads it via envDir in frontend/vite.config.js; only the
#     VITE_-prefixed vars are exposed to client code (backend secrets are NOT).
# `.env` is gitignored. Missing required values abort startup with a clear error.
#
# DEPLOYMENT NOTE (Render / single server): in production the Express backend
# serves the built frontend AND the API on the SAME origin + port. You do NOT
# create a `.env` on Render — set these as environment variables there instead
# (see render.yaml). PORT is injected automatically by Render.
# ─────────────────────────────────────────────────────────────────────────────

# ── Runtime ──────────────────────────────────────────────────────────────────
# NODE_ENV: development | production | test
NODE_ENV=development
# Backend port (locally). On Render this is injected automatically — do not set it.
PORT=3001
# LOG_LEVEL: error | warn | info | debug   (optional, defaults to info)
LOG_LEVEL=info
# OPTIONAL. Only needed if the frontend is hosted on a DIFFERENT origin than the
# API. In the default single-server deploy, leave these empty (same origin).
CLIENT_URL=
CORS_ORIGINS=

# ── LLM provider & models ────────────────────────────────────────────────────
LLM_PROVIDER=groq
# OPTIONAL. Without a key the app runs in demo/fallback mode (no live LLM calls).
# Get a key at https://console.groq.com
GROQ_API_KEY=
# Default text model (must be one of AVAILABLE_MODELS below).
DEFAULT_MODEL=llama-3.3-70b-versatile
# Comma-separated model ids. Use valid Groq model ids. Edit freely — the backend
# and the UI selector pick these up with no code changes.
AVAILABLE_MODELS=llama-3.1-8b-instant,llama-3.3-70b-versatile,openai/gpt-oss-120b,openai/gpt-oss-20b,openai/gpt-oss-safeguard-20b,qwen/qwen3-32b,groq/compound,groq/compound-mini

# ── External news API (optional) ─────────────────────────────────────────────
# Leave NEWS_API_KEY empty to use built-in demo articles instead of live NewsAPI.
# NEWS_API_URL is only required when a key is supplied.
NEWS_API_KEY=
NEWS_API_URL=https://newsapi.org/v2/everything

# ─────────────────────────────────────────────────────────────────────────────
# FRONTEND (Vite) — only VITE_-prefixed vars are exposed to the browser bundle.
# Read ONLY through frontend/src/config/index.js.
# ─────────────────────────────────────────────────────────────────────────────
# Backend API base URL. Leave EMPTY for the single-server deploy: the app then
# calls the API on the same origin via relative `/api` paths (no CORS).
VITE_API_URL=
# App environment: development | production
VITE_APP_ENV=development
# Vite dev server port (local dev only).
VITE_DEV_PORT=5173
# OPTIONAL (local dev only). Where the dev server proxies `/api`. Defaults to
# http://localhost:${PORT}. Set only if your backend runs elsewhere in dev.
VITE_API_PROXY_TARGET=
# LLM (display only — actual calls happen on the backend). Mirror the lists above.
VITE_LLM_PROVIDER=groq
VITE_DEFAULT_MODEL=llama-3.3-70b-versatile
VITE_AVAILABLE_MODELS=llama-3.1-8b-instant,llama-3.3-70b-versatile,openai/gpt-oss-120b,openai/gpt-oss-20b,openai/gpt-oss-safeguard-20b,qwen/qwen3-32b,groq/compound,groq/compound-mini
# Friendly labels (id=Label;…) matching the Groq console display names.
VITE_MODEL_LABELS=llama-3.1-8b-instant=Llama 3.1 8B;llama-3.3-70b-versatile=Llama 3.3 70B;openai/gpt-oss-120b=GPT-OSS 120B;openai/gpt-oss-20b=GPT-OSS 20B;openai/gpt-oss-safeguard-20b=GPT-OSS Safeguard 20B;qwen/qwen3-32b=Qwen 3 32B;groq/compound=Groq Compound;groq/compound-mini=Groq Compound Mini
# Clerk auth (OPTIONAL). Leave empty to keep auth disabled — the app still boots.
# Get yours at https://dashboard.clerk.com/~/api-keys (React).
VITE_CLERK_PUBLISHABLE_KEY=
